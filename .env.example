# ---- Core (used by the pre-built shell) ----
DATABASE_URL=postgresql+asyncpg://chronicle:chronicle@localhost:5432/chronicle
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-any-shared-environment
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Providers (read by the live-built router; the pre-build never calls a model) ----
# Primary model: Gemini. Model ids are pinned at the live build.
GEMINI_API_KEY=
GEMINI_PRO_MODEL=
GEMINI_FLASH_MODEL=

# Adaption (docs.adaptionlabs.ai): hosts the judge and, once trained, the creative enhancer.
ADAPTION_API_KEY=

# Judge: must NOT be Gemini/Gemma (cross-family rule, ADR 0004). Ids come from Adaption's Models page.
JUDGE_MODEL=qwen3.5-397b
JUDGE_FALLBACK_MODEL=deepseek-v4-flash

# Creative enhancer (ADR 0007). Empty CREATIVE_MODEL = the stage is skipped.
#   adaption          -> hosted model/stack via the adaption SDK (CREATIVE_MODEL e.g. a model id or stack:<slug>)
#   openai_compatible -> self-hosted tuned LoRA; set CREATIVE_BASE_URL and CREATIVE_API_KEY
CREATIVE_BACKEND=adaption
CREATIVE_MODEL=
CREATIVE_BASE_URL=
CREATIVE_API_KEY=

# Embeddings provider is undecided; add its key when chosen.

# ---- Observability (wired live) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
